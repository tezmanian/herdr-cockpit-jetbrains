<idea-plugin url="https://github.com/tezmanian/herdr-cockpit-jetbrains">
    <id>io.github.tezmanian.herdrcockpit</id>
    <name>Herdr Cockpit</name>
    <vendor>tezmanian</vendor>
    <description><![CDATA[
    Community (unofficial) client for <a href="https://herdr.dev">Herdr</a>, the terminal multiplexer for coding agents:
    its spaces, agents and shells in the IDE. Switch a space and its folder and every agent and shell (as editor tabs)
    are right there. A JetBrains port of
    <a href="https://github.com/sriharirao92/vscode-herdr-cockpit">Herdr Cockpit for VS Code</a>.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <!-- 2026.2 moved JCEF (the sidebar) into its own plugin; without this the class loader cannot see JBCefApp. -->
    <depends>com.intellij.modules.jcef</depends>
    <!-- "Review with Agent…" in the GitLab tool window's merge request changes; without the GitLab plugin it's just absent. -->
    <depends optional="true" config-file="herdr-gitlab.xml">org.jetbrains.plugins.gitlab</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Herdr" anchor="left" icon="/icons/herdr.svg"
                    factoryClass="io.github.tezmanian.herdrcockpit.HerdrToolWindowFactory"/>
        <fileEditorProvider implementation="io.github.tezmanian.herdrcockpit.HerdrPaneEditorProvider"/>
        <editorTabTitleProvider implementation="io.github.tezmanian.herdrcockpit.HerdrPaneTabTitleProvider"/>
        <fileIconProvider implementation="io.github.tezmanian.herdrcockpit.HerdrPaneIconProvider"/>
        <applicationConfigurable parentId="tools" instance="io.github.tezmanian.herdrcockpit.HerdrConfigurable"
                                 id="herdr.cockpit" displayName="Herdr Cockpit"/>
        <statusBarWidgetFactory id="HerdrCockpit.Status" implementation="io.github.tezmanian.herdrcockpit.HerdrStatusBarFactory"/>
        <httpRequestHandler implementation="io.github.tezmanian.herdrcockpit.HerdrLinkService"/>
        <postStartupActivity implementation="io.github.tezmanian.herdrcockpit.HerdrLinkStartup"/>
        <notificationGroup id="Herdr Cockpit" displayType="BALLOON"/>
    </extensions>

    <actions>
        <group id="HerdrCockpit.Actions" text="Herdr" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="HerdrCockpit.SwitchSpace" class="io.github.tezmanian.herdrcockpit.SwitchSpaceAction"/>
            <action id="HerdrCockpit.FocusAttention" class="io.github.tezmanian.herdrcockpit.FocusAttentionAction"/>
            <action id="HerdrCockpit.Refresh" class="io.github.tezmanian.herdrcockpit.RefreshAction"/>
            <action id="HerdrCockpit.OpenTui" class="io.github.tezmanian.herdrcockpit.OpenTuiAction"/>
            <action id="HerdrCockpit.SendToAgent" class="io.github.tezmanian.herdrcockpit.SendToAgentAction">
                <add-to-group group-id="EditorPopupMenu" anchor="last"/>
                <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            </action>
            <action id="HerdrCockpit.OpenPaneOutput" class="io.github.tezmanian.herdrcockpit.OpenPaneOutputAction">
                <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
            </action>
        </group>
    </actions>
</idea-plugin>
